          - ✅/❌ Circuit breaker thresholds tuned
          - ✅/❌ Cost tracking verified in Firestore
          - ✅/❌ Monitoring alerts configured
          - ✅/❌ Cache warming scheduled (if applicable)
          - ✅/❌ Fallback mechanism tested
          - ✅/❌ Integration tests passing in staging
        </content>
      </section>

      <section name="known_limitations" required="false">
        <description>Current limitations and future improvements</description>
        <content>
          - Known edge cases not yet handled
          - Performance bottlenecks to address
          - Future optimization opportunities
          - Service-specific quirks to be aware of
        </content>
      </section>
    </sections>
  </output>

  <code_patterns>
    <pattern name="retry_with_exponential_backoff">
      <description>Retry failed API calls with increasing delays</description>
      <example>
        <![CDATA[
async function retryWithBackoff<T>(
  operation: () => Promise<T>,
  maxRetries: number = 3,
  baseDelayMs: number = 1000
): Promise<T> {
  for (let attempt = 0; attempt < maxRetries; attempt++) {
    try {
      return await operation();
    } catch (error) {
      if (attempt === maxRetries - 1 || !isRetriableError(error)) {
        throw error;
      }
      const delayMs = baseDelayMs * Math.pow(2, attempt); // 1s, 2s, 4s
      await new Promise(resolve => setTimeout(resolve, delayMs));
    }
  }
}
        ]]>
      </example>
    </pattern>

    <pattern name="circuit_breaker">
      <description>Prevent cascading failures by opening circuit after threshold</description>
      <example>
        <![CDATA[
class CircuitBreaker {
  private failureCount = 0;
  private lastFailureTime = 0;
  private readonly THRESHOLD = 5;
  private readonly TIMEOUT_MS = 60000;

  async execute<T>(operation: () => Promise<T>): Promise<T> {
    if (this.isOpen()) {
      throw new Error('Circuit breaker open');
    }

    try {
      const result = await operation();
      this.onSuccess();
      return result;
    } catch (error) {
      this.onFailure();
      throw error;
    }
  }

  private isOpen(): boolean {
    if (this.failureCount < this.THRESHOLD) return false;
    return Date.now() - this.lastFailureTime < this.TIMEOUT_MS;
  }

  private onSuccess(): void {
    this.failureCount = 0;
  }

  private onFailure(): void {
    this.failureCount++;
    this.lastFailureTime = Date.now();
  }
}
        ]]>
      </example>
    </pattern>

    <pattern name="cost_tracking">
      <description>Log API costs to Firestore for monitoring</description>
      <example>
        <![CDATA[
async function trackCost(params: {
  userId: string;
  service: string;
  operation: string;
  estimatedCost: number;
  tokenCount?: number;
  duration?: number;
  fromCache: boolean;
}): Promise<void> {
  await firestore.collection('costLogs').add({
    ...params,
    timestamp: FieldValue.serverTimestamp(),
    responseTime: Date.now() - startTime
  });
}
        ]]>
      </example>
    </pattern>

    <pattern name="cache_check">
      <description>Check cache before calling external API</description>
      <example>
        <![CDATA[
async function getCachedOrFetch<T>(
  cacheKey: string,
  fetchFn: () => Promise<T>,
  ttlSeconds?: number
): Promise<{ data: T; fromCache: boolean }> {
  // Check cache
  const cached = await firestore.collection('cache').doc(cacheKey).get();
  if (cached.exists && !isCacheExpired(cached.data(), ttlSeconds)) {
    return { data: cached.data().result as T, fromCache: true };
  }

  // Fetch from API
  const result = await fetchFn();

  // Store in cache
  await firestore.collection('cache').doc(cacheKey).set({
    result,
    cachedAt: FieldValue.serverTimestamp()
  });

  return { data: result, fromCache: false };
}
        ]]>
      </example>
    </pattern>
  </code_patterns>

  <examples>
    <example name="deepgram_integration">
      <description>Speech-to-text integration with Deepgram API</description>
      <input>
        service_name: "deepgram"
        description: "Transcribe user speech to text for conversation input"
        cost_optimization: "Cache transcriptions by audio file hash, batch process recordings"
