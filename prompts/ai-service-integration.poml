  </examples>

  <stylesheet>
    <verbosity level="detailed">
      Provide comprehensive implementation details, especially for error handling and cost optimization.
      Include rationale for architectural decisions.
    </verbosity>

    <error_handling style="paranoid-level">
      Assume every external call can fail.
      Handle all error types explicitly.
      Never let exceptions bubble up without context.
    </error_handling>

    <cost_tracking preference="mandatory">
      Log every API call with cost calculation.
      Track cache hit/miss rates.
      Provide cost projections and optimization recommendations.
    </cost_tracking>

    <logging style="production-grade">
      Log all significant events (API calls, errors, circuit breaker state changes).
      Include context: userId, operation, timestamp, duration.
      Never log sensitive data (API keys, user audio content).
    </logging>

    <code_style>
      - Async/await for all async operations
      - Explicit error types (no generic Error)
      - Defensive coding: null checks, input validation
      - Configuration via environment variables
      - No magic numbers (use named constants)
    </code_style>
  </stylesheet>

  <quality_gates>
    <gate name="cost_validation" blocking="true">
      Cost calculations must be accurate within 5% margin
    </gate>
    <gate name="error_coverage" blocking="true">
      All error scenarios must be tested (timeout, 4xx, 5xx, network)
    </gate>
    <gate name="security_check" blocking="true">
      No API keys in code, logs, or error messages
    </gate>
    <gate name="circuit_breaker_test" blocking="true">
      Circuit breaker must open/close correctly under load
    </gate>
    <gate name="cache_hit_rate" blocking="false">
      Target 80% cache hit rate (warning if below 70%)
    </gate>
  </quality_gates>

